# Copy to config/boot1oot.local.env and edit locally.
# The local file is ignored by Git because it may contain recovery keys.

# When set to 1, selected values are baked into the ISO environment and passed
# into the boot1oot binary at compile time.
BOOT1OOT_EXPORT_CONFIG=0

# BitLocker recovery key used by `boot1oot mount`/`boot1oot dislocker`.
# Leave empty to use the interactive dislocker prompt.
BOOT1OOT_BITLOCKER_RECOVERY_KEY=

# Passphrase for encrypted `boot1oot loot` fallback archives written to
# C:\Users\Public\Boot1oot when the USB loot partition is unavailable.
# Leave empty to use the built-in fallback passphrase: boot1oot
BOOT1OOT_LOOT_PASSPHRASE=
